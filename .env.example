# Copy this file to .env and fill in real values. Never commit .env.

# --- WordPress core ---
WP_ENV=local
WP_HOME=http://beauclick.test
WP_SITEURL=http://beauclick.test
WP_DEBUG=true

# --- Database ---
DB_NAME=beauclick
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PREFIX=wp_

# --- WordPress security salts ---
# Generate a fresh set for every environment at https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# --- Payment gateways (Iranian) ---
# Fill in whichever gateway(s) BeauClick enables. Keep TEST keys in local/staging.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# --- AI provider (beauclick-ai module) ---
# Provider-agnostic: set BC_AI_PROVIDER to the adapter to use (e.g. "anthropic", "openai").
# The API key is only ever read server-side (beauclick-ai plugin) and never exposed to the frontend.
BC_AI_PROVIDER=
BC_AI_API_KEY=
BC_AI_MODEL=

# --- Object storage (production media offload, optional in local dev) ---
BC_STORAGE_DRIVER=local
BC_STORAGE_KEY=
BC_STORAGE_SECRET=
BC_STORAGE_BUCKET=
BC_STORAGE_REGION=
BC_STORAGE_ENDPOINT=

# --- Chat / notifications ---
BC_MAIL_FROM_ADDRESS=no-reply@beauclick.test
BC_MAIL_FROM_NAME=BeauClick
