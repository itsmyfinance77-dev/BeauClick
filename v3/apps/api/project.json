{
  "name": "api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["type:app", "scope:app"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "tsc -p apps/api/tsconfig.json" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc -p apps/api/tsconfig.json --noEmit" } },
    "dev": { "executor": "nx:run-commands", "options": { "command": "ts-node -r tsconfig-paths/register apps/api/src/main.ts" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "jest --config apps/api/jest.config.js" } },
    "test:pg": { "executor": "nx:run-commands", "options": { "command": "jest --config apps/api/jest.pg.config.js" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint apps/api/src apps/api/test --resolve-plugins-relative-to ." } }
  }
}
