{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // outDir is the dist ROOT, with rootDir pinned to the workspace root, so
    // compiled output mirrors the source tree exactly:
    //   dist/apps/api/src/main.js, dist/libs/..., dist/services/...
    // Previously outDir already contained "apps/api" while tsc ALSO preserved
    // each file's path from the inferred common root, producing a doubled
    // dist/apps/api/apps/api/src/main.js. Pinning rootDir removes the
    // inference (and with it the ambiguity when the set of input files
    // changes).
    "outDir": "../../dist",
    "rootDir": "../..",
    "module": "commonjs",
    "baseUrl": "../..",
    "paths": {
      "@beauclick/http": ["libs/http/src/index.ts"],
      "@beauclick/auth": ["libs/auth/src/index.ts"],
      "@beauclick/ownership": ["libs/ownership/src/index.ts"],
      "@beauclick/identity": ["services/identity/src/index.ts"],
      "@beauclick/provider": ["services/provider/src/index.ts"],
      "@beauclick/booking": ["services/booking/src/index.ts"],
      "@beauclick/commerce": ["services/commerce/src/index.ts"],
      "@beauclick/payment": ["services/payment/src/index.ts"],
      "@beauclick/financial": ["services/financial/src/index.ts"],
      "@beauclick/money": ["libs/money/src/index.ts"],
      "@beauclick/events": ["libs/events/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
