# V3_INFRASTRUCTURE_PLAN.md §4 -- managed Postgres connection string, once a real hosting decision is made.
DATABASE_URL=postgres://beauclick:beauclick@localhost:5432/beauclick
NODE_ENV=development
PORT=3000

# Absolute base URLs, used to build the gateway callback URL and the
# customer's post-payment return. Must be reachable by the gateway.
PUBLIC_API_BASE_URL=http://localhost:3099/api
PUBLIC_WEB_BASE_URL=http://localhost:3100

# Comma-separated allow-list of browser origins permitted to call this API.
# NEVER a wildcard: apps/web's real origin only.
CORS_ALLOWED_ORIGINS=http://localhost:3100

# --- Global rate limiting (V3_SECURITY_MODEL.md §13) ---
#
# Five named policies -- ONE registered throttler (`default`) plus four
# per-route overrides of it, applied by BeauClickThrottlerGuard (registered
# globally in AppModule). Each is keyed on the AUTHENTICATED user id when
# there is one and the client IP otherwise; `trust proxy` is deliberately
# left off so X-Forwarded-For cannot be used to buy extra budget.
#
# Every value below is a provisional ENGINEERING default (GAP-10 class), not
# a business or infrastructure sign-off -- they are overridable here
# precisely so infrastructure can retune against real traffic without a code
# change. Unset means "use the built-in default shown".
#
# default   120/min  ordinary authenticated app usage
# read      300/min  search/autocomplete/listing + the payment callback.
#                    Derived from a real workload fact, not guessed: the
#                    search page debounces autocomplete at 250ms, so
#                    sustained typing legitimately issues ~240 req/min.
# mutation   30/min  booking/checkout -- tighter on purpose; these claim
#                    slots and open gateway attempts.
# auth      100/min  OTP request/verify. A coarse DoS backstop only -- the
#                    REAL business rule is OtpService's own 5/phone/hour +
#                    10/IP/hour, and this sits deliberately above it.
# refresh    20/min  token refresh
#
# /health is the ONLY exempt route, because throttling a liveness probe
# would eventually mark a healthy service unhealthy and pull it from
# rotation.
#
# NOTE: storage is in-memory PER PROCESS. With more than one API instance
# the effective limit multiplies by instance count; a shared store (Redis)
# is the correct fix at multi-instance scale.
# THROTTLE_DEFAULT_LIMIT=120
# THROTTLE_DEFAULT_TTL_MS=60000
# THROTTLE_READ_LIMIT=300
# THROTTLE_READ_TTL_MS=60000
# THROTTLE_MUTATION_LIMIT=30
# THROTTLE_MUTATION_TTL_MS=60000
# THROTTLE_AUTH_LIMIT=100
# THROTTLE_AUTH_TTL_MS=60000
# THROTTLE_REFRESH_LIMIT=20
# THROTTLE_REFRESH_TTL_MS=60000

# ADR-008 -- never commit a real value. Generate a long random string per environment.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# V3_SECURITY_MODEL.md §2 -- never commit a real value.
OTP_HMAC_SECRET=
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=10

# === Phase 2 ===

# ADR-009 / ADR-017. A SEPARATE connection, as the beauclick_financial_writer
# role: INSERT + SELECT on the financial schema and nothing else. The
# application refuses to boot without it -- silently falling back to
# DATABASE_URL would hand the main pool write access to the ledger and void
# the append-only guarantee. Bootstrap the roles once per environment with
# database/scripts/financial-roles.sql, as a superuser.
FINANCIAL_DATABASE_URL=

# Commission rate in BASIS POINTS (1500 = 15%). Provisional default carried
# from V2, which itself labelled it NEEDS_BUSINESS_DECISION -- not final
# commercial policy. Every ledger row captures the rate it used, so changing
# this affects only future transactions.
FINANCIAL_COMMISSION_RATE_BP=1500

# Which gateway adapter to use. Required once more than one is registered --
# deliberately not "first one wins", which would make the production gateway
# depend on module import order.
PAYMENT_DEFAULT_PROVIDER=sandbox
PAYMENT_INTENT_TTL_MINUTES=30

# How long a server-to-server verification may take before the outcome is
# treated as UNRESOLVED (V3.1 Phase F). Not a tuning knob for latency: it is
# what stops a gateway that accepts the connection and never answers from
# holding the customer's browser -- and what guarantees an ambiguous
# verification writes nothing rather than recording a guess. Default 15000.
PAYMENT_VERIFY_TIMEOUT_MS=15000

# Which payment WORLD this deployment is talking to. `sandbox` selects the
# local simulated bank; a real deployment sets this to `production` AND
# registers a real gateway adapter (GAP-06 -- no such adapter exists yet, and
# no merchant credentials exist in this environment).
#
# SandboxPaymentProvider requires this to be `sandbox` AND NODE_ENV to be
# anything other than `production`. Both conditions, independently. There is
# deliberately NO override flag that re-enables the sandbox under
# NODE_ENV=production -- the old PAYMENT_ALLOW_MOCK_GATEWAY escape hatch was
# REMOVED rather than carried forward, because a simulated bank that can be
# switched on in production by setting one environment variable is exactly
# the hazard a V2 readiness audit found in its Cash-on-Delivery stand-in.
PAYMENT_ENVIRONMENT=sandbox

# Where SandboxPaymentProvider sends the customer's browser -- the simulated
# bank's own checkout page, standing in for a page a real gateway would host
# on its own domain.
PAYMENT_SANDBOX_CHECKOUT_URL=http://localhost:3100/sandbox-gateway

# Booking business rules. Provisional engineering defaults, overridable --
# see BookingConfig for what each one guards against.
BOOKING_HOLD_MINUTES=15
BOOKING_MAX_CONCURRENT_HOLDS=5
BOOKING_MAX_RESCHEDULES=2
BOOKING_RESCHEDULE_MIN_HOURS_BEFORE=6

# Background sweeps. Both are backstops, not mechanisms: availability is freed
# in real time by the claim predicate, and the outbox is drained post-commit.
OUTBOX_SWEEP_INTERVAL_MS=5000
HOLD_EXPIRY_SWEEP_INTERVAL_MS=60000
# DISABLE_BACKGROUND_SWEEPS=true

# === Phase 3 ===

# ADR-021 -- search is a read model, never system-of-record. REQUIRED in
# production: the app refuses to boot rather than silently fall back to the
# in-memory engine, which would serve an empty marketplace with no visible
# error. Unset locally, SearchModule uses the in-memory engine instead.
OPENSEARCH_URL=

# ADR-020. 'lax' is correct when the API and web app share a registrable
# domain. A deployment putting them on genuinely different sites must set
# 'none' AND AUTH_COOKIE_SECURE=true -- the config validator refuses to boot
# on the invalid combination.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# GAP-10: V2's placeholder, kept configurable and marked unresolved rather
# than quietly adopted as decided policy. GET /v1/admin/loyalty/policy reports
# which values are still running on it.
LOYALTY_POINTS_BOOKING_COMPLETED=10
LOYALTY_TIER_BASIS=lifetime

SEARCH_FLUSH_INTERVAL_MS=5000
NOTIFICATION_RETRY_INTERVAL_MS=30000
ANALYTICS_ROLLUP_INTERVAL_MS=300000
MEMBERSHIP_EXPIRY_INTERVAL_MS=900000
