# V3_INFRASTRUCTURE_PLAN.md §4 -- managed Postgres connection string, once a real hosting decision is made.
DATABASE_URL=postgres://beauclick:beauclick@localhost:5432/beauclick
NODE_ENV=development
PORT=3000

# Absolute base URLs, used to build the gateway callback URL and the
# customer's post-payment return. Must be reachable by the gateway.
PUBLIC_API_BASE_URL=http://localhost:3099/api
PUBLIC_WEB_BASE_URL=http://localhost:3100

# Comma-separated allow-list of browser origins permitted to call this API.
# NEVER a wildcard: apps/web's real origin only.
CORS_ALLOWED_ORIGINS=http://localhost:3100

# ADR-008 -- never commit a real value. Generate a long random string per environment.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# V3_SECURITY_MODEL.md §2 -- never commit a real value.
OTP_HMAC_SECRET=
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=10

# === Phase 2 ===

# ADR-009 / ADR-017. A SEPARATE connection, as the beauclick_financial_writer
# role: INSERT + SELECT on the financial schema and nothing else. The
# application refuses to boot without it -- silently falling back to
# DATABASE_URL would hand the main pool write access to the ledger and void
# the append-only guarantee. Bootstrap the roles once per environment with
# database/scripts/financial-roles.sql, as a superuser.
FINANCIAL_DATABASE_URL=

# Commission rate in BASIS POINTS (1500 = 15%). Provisional default carried
# from V2, which itself labelled it NEEDS_BUSINESS_DECISION -- not final
# commercial policy. Every ledger row captures the rate it used, so changing
# this affects only future transactions.
FINANCIAL_COMMISSION_RATE_BP=1500

# Which gateway adapter to use. Required once more than one is registered --
# deliberately not "first one wins", which would make the production gateway
# depend on module import order.
PAYMENT_DEFAULT_PROVIDER=mock
PAYMENT_INTENT_TTL_MINUTES=30

# Where MockGatewayProvider sends the customer's browser. The mock is disabled
# in production unless PAYMENT_ALLOW_MOCK_GATEWAY=true is set explicitly -- it
# fails CLOSED, so a production deploy cannot silently enable an
# unauthenticated "payment succeeded" path (the exact hazard a V2 readiness
# audit found in its Cash-on-Delivery stand-in).
PAYMENT_MOCK_CHECKOUT_URL=http://localhost:3100/mock-gateway
# PAYMENT_ALLOW_MOCK_GATEWAY=false

# Booking business rules. Provisional engineering defaults, overridable --
# see BookingConfig for what each one guards against.
BOOKING_HOLD_MINUTES=15
BOOKING_MAX_CONCURRENT_HOLDS=5
BOOKING_MAX_RESCHEDULES=2
BOOKING_RESCHEDULE_MIN_HOURS_BEFORE=6

# Background sweeps. Both are backstops, not mechanisms: availability is freed
# in real time by the claim predicate, and the outbox is drained post-commit.
OUTBOX_SWEEP_INTERVAL_MS=5000
HOLD_EXPIRY_SWEEP_INTERVAL_MS=60000
# DISABLE_BACKGROUND_SWEEPS=true
