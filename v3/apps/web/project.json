{
  "name": "web",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": ["type:app", "scope:app"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "next build", "cwd": "apps/web" } },
    "dev": { "executor": "nx:run-commands", "options": { "command": "next dev -p 3100", "cwd": "apps/web" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc -p apps/web/tsconfig.json --noEmit" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "jest --config apps/web/jest.config.js" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint apps/web/app apps/web/lib apps/web/components apps/web/test --resolve-plugins-relative-to ." } }
  }
}
