{
  "name": "beauclick-v3",
  "version": "0.0.0",
  "private": true,
  "description": "BeauClick V3 monorepo — Phase 1: identity-service + provider-service foundation. See docs/roadmap/v3/V3_REPOSITORY_STRUCTURE.md (ADR-011) for the full architecture this workspace implements.",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "eslint \"apps/**/src/**/*.ts\" \"apps/**/test/**/*.ts\" \"services/**/src/**/*.ts\" \"libs/**/src/**/*.ts\" \"packages/**/src/**/*.ts\" \"database/scripts/**/*.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "nx run-many -t typecheck",
    "test:pg": "nx run api:test:pg",
    "migrate": "ts-node --project database/scripts/tsconfig.json database/scripts/migrate.ts",
    "verify:roles": "ts-node --project database/scripts/tsconfig.json database/scripts/verify-roles.ts",
    "backup": "ts-node --project database/scripts/tsconfig.json database/scripts/backup.ts",
    "restore:rehearse": "ts-node --project database/scripts/tsconfig.json database/scripts/restore-rehearsal.ts",
    "api:dev": "nx run api:dev"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "23.1.1",
    "@opensearch-project/opensearch": "^3.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "cookie-parser": "^1.4.7",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nx": "^23.1.1",
    "pg": "^8.23.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typeorm-naming-strategies": "^4.1.0",
    "typescript": "^5.6.3",
    "zod": "^4.4.3"
  }
}
