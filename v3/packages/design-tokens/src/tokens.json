{
  "$schema": "Canonical BeauClick design tokens — single source of truth. tokens.css is kept in sync with this file by hand and contrast.spec.ts asserts that it is. Source: docs/design/V3_DESIGN_SYSTEM.md (V3.3 design language, 2026-09-12).",
  "color": {
    "surface": { "value": "oklch(1 0 0)", "use": "cards, header" },
    "surfacePage": { "value": "oklch(0.985 0.008 75)", "use": "page ground — warm" },
    "surfaceMuted": { "value": "oklch(0.978 0.006 75)", "use": "table head, readable blocks" },
    "surfaceTint": { "value": "oklch(0.978 0.008 340)", "use": "tinted surface — context band, active row" },
    "border": { "value": "oklch(0.9 0.008 60)", "use": "default border" },
    "borderStrong": { "value": "oklch(0.82 0.014 60)", "use": "prominent card border" },
    "text": { "value": "oklch(0.22 0.02 330)", "use": "primary text" },
    "textMuted": { "value": "oklch(0.46 0.02 330)", "use": "secondary text" },
    "textFaint": { "value": "oklch(0.55 0.015 330)", "use": "labels, units, captions — 0.55 not the design sheet's 0.58, which measures 4.32:1 on white" },
    "textDisabled": { "value": "oklch(0.68 0.012 330)", "use": "disabled — never the only copy of a consequence" },
    "primary": { "value": "oklch(0.42 0.13 340)", "use": "primary action, selected state" },
    "primaryHover": { "value": "oklch(0.34 0.12 340)", "use": "hover" },
    "primarySoft": { "value": "oklch(0.945 0.026 340)", "use": "badge and soft primary ground" },
    "primaryOnSoft": { "value": "oklch(0.36 0.11 340)", "use": "text on the soft primary ground" },
    "accent": { "value": "oklch(0.62 0.095 65)", "soft": "oklch(0.955 0.028 70)", "use": "bronze — surfaces, borders and icons only (3.70:1, the UI-component threshold), never text" },
    "accentOnSoft": { "value": "oklch(0.46 0.09 65)", "use": "bronze TEXT, on white or on the soft bronze ground" },
    "success": { "value": "oklch(0.4 0.098 155)", "soft": "oklch(0.945 0.036 155)", "use": "confirmed states" },
    "warning": { "value": "oklch(0.46 0.09 75)", "soft": "oklch(0.955 0.028 70)", "use": "pending states" },
    "error": { "value": "oklch(0.5 0.16 25)", "soft": "oklch(0.929 0.035 25)", "use": "cancelled, refused, destructive" },
    "info": { "value": "oklch(0.52 0.11 245)", "soft": "oklch(0.964 0.018 245)", "use": "informational — the fourth role, absent until V3.3" }
  },
  "gradient": {
    "brand": "linear-gradient(135deg, var(--bc-color-primary), var(--bc-color-accent))"
  },
  "typography": {
    "fontFamily": "var(--bc-font-vazir, 'Vazirmatn'), Tahoma, system-ui, sans-serif",
    "fontDisplay": "var(--bc-font-anjoman, 'Anjoman'), var(--bc-font-family)",
    "fontHero": "var(--bc-font-peyda, 'Peyda'), var(--bc-font-display)",
    "fontWeights": [400, 500, 700, 800, 900],
    "direction": "rtl",
    "digits": "persian",
    "minReadablePx": 13,
    "scale": {
      "display1": { "size": "52px", "weight": 900, "lineHeight": 1.45, "face": "anjoman", "use": "customer platform only" },
      "display2": { "size": "38px", "weight": 800, "lineHeight": 1.45, "face": "anjoman", "use": "customer platform only" },
      "pageTitle": { "size": "32px", "weight": 800, "lineHeight": 1.45 },
      "section": { "size": "24px", "weight": 800, "lineHeight": 1.45 },
      "subhead": { "size": "20px", "weight": 700, "lineHeight": 1.5 },
      "cardTitle": { "size": "17px", "weight": 700, "lineHeight": 1.5 },
      "body": { "size": "16px", "weight": 400, "lineHeight": 1.85 },
      "compact": { "size": "14px", "weight": 400, "lineHeight": 1.75, "use": "admin density" },
      "label": { "size": "13px", "weight": 500, "lineHeight": 1.7 },
      "small": { "size": "13px", "weight": 400, "lineHeight": 1.7 },
      "badge": { "size": "12px", "weight": 700, "use": "badges and short chips only — never a sentence" }
    },
    "numericVariant": "tabular-nums"
  },
  "spacing": {
    "sectionPaddingMobile": "24px",
    "sectionPaddingDesktop": "40px",
    "contentMaxWidth": "1280px",
    "cardGap": "16px",
    "cardGapLarge": "20px",
    "chipGap": "8px",
    "chipGapLarge": "10px",
    "gutterCustomer": "48px",
    "gutterPro": "32px",
    "gutterAdmin": "24px"
  },
  "radius": {
    "card": "16px",
    "cardLg": "18px",
    "control": "10px",
    "input": "10px",
    "chip": "999px",
    "cell": "7px",
    "ceiling": "18px"
  },
  "shadow": {
    "subtle": "0 1px 3px oklch(0.3 0.04 340 / 0.1)",
    "card": "0 2px 8px oklch(0.3 0.04 340 / 0.06)",
    "float": "0 10px 32px oklch(0.3 0.04 340 / 0.08)",
    "bar": "0 -6px 20px oklch(0.3 0.04 340 / 0.08)"
  },
  "motion": {
    "hover": { "duration": "120ms", "easing": "ease-out" },
    "panel": { "duration": "200ms", "easing": "cubic-bezier(0.2, 0, 0, 1)" },
    "sheet": { "duration": "240ms", "easing": "cubic-bezier(0.2, 0, 0, 1)" },
    "skeleton": { "duration": "1.2s", "easing": "ease-in-out" }
  },
  "breakpoint": {
    "mobile": "640px",
    "tablet": "640px",
    "desktop": "1024px"
  }
}
