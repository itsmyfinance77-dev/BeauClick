<?xml version="1.0"?>
<ruleset name="BeauClick">
    <description>WordPress Coding Standards for all beauclick-* plugins and the beauclick theme.</description>

    <file>wordpress/wp-content/plugins</file>
    <file>wordpress/wp-content/themes/beauclick</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="testVersion" value="8.2-"/>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="beauclick"/>
                <element value="BeauClick"/>
                <element value="bc_"/>
            </property>
        </properties>
    </rule>
</ruleset>
