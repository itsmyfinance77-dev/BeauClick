{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "beauclick-app-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173,
      "cwd": "app"
    },
    {
      "name": "beauclick-wordpress",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S",
        "localhost:8080",
        "router.php"
      ],
      "port": 8080,
      "cwd": "wordpress"
    },
    {
      "name": "beauclick-v3-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "run",
        "api:dev"
      ],
      "port": 3099,
      "cwd": "v3"
    },
    {
      "name": "beauclick-v3-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100,
      "cwd": "v3/apps/web"
    },
    {
      "name": "beauclick-v3-web-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3200"
      ],
      "port": 3200,
      "cwd": "v3/apps/web"
    }
  ]
}