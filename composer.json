{
    "name": "beauclick/platform",
    "description": "BeauClick — Persian nationwide beauty marketplace, booking, ecommerce, B2B & AI platform. Manages WordPress core + WooCommerce + dev tooling; each wp-content/plugins/beauclick-* module has its own composer.json for its own PSR-4 autoloading.",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.3",
        "wpackagist-plugin/woocommerce": "^9.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "extra": {
        "installer-paths": {
            "wordpress/wp-content/plugins/{$name}/": [ "type:wordpress-plugin" ],
            "wordpress/wp-content/themes/{$name}/": [ "type:wordpress-theme" ]
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist",
        "test": "phpunit -c phpunit.xml.dist",
        "bc-migrate": "wp bc:migrate",
        "bc-seed": "wp bc:seed"
    }
}
